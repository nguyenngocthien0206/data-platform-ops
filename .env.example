# Copy to .env and edit. .env is gitignored and must never be committed.
#   cp .env.example .env

# Postgres: the company's legacy database, and the toolkit's own results in a
# second database (platform_ops). Started by `make up`.
POSTGRES_USER=platform_ops
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=legacy
POSTGRES_PORT=5432

# ClickHouse: the company's warehouse, where dbt builds. Started by `make up`.
CLICKHOUSE_USER=platform_ops
CLICKHOUSE_PASSWORD=change_me_locally
CLICKHOUSE_PORT=8123

# The simulated company's ClickHouse users (version 2.0): one per team, plus
# the BI tool and the two pipelines. Each has its own password, and nothing
# defaults them: a missing one stops `make demo` and names the variable.
CLICKHOUSE_PASSWORD_PLATFORM=change_me_locally_platform
CLICKHOUSE_PASSWORD_SALES=change_me_locally_sales
CLICKHOUSE_PASSWORD_MARKETING=change_me_locally_marketing
CLICKHOUSE_PASSWORD_FINANCE=change_me_locally_finance
CLICKHOUSE_PASSWORD_PRODUCT=change_me_locally_product
CLICKHOUSE_PASSWORD_METABASE=change_me_locally_metabase
CLICKHOUSE_PASSWORD_DBT=change_me_locally_dbt
CLICKHOUSE_PASSWORD_LOADER=change_me_locally_loader

# The Streamlit dashboards (`make dashboard`) read the toolkit's results in
# Postgres as their own read-only role, created by `make demo`. No default.
POSTGRES_PASSWORD_DASHBOARD=change_me_locally_dashboard

# Metabase, the company's BI (`make metabase`): its port, and the admin account
# `platform-ops metabase provision` creates on first start and logs in with.
METABASE_PORT=3000
MB_ADMIN_EMAIL=admin@company.test
MB_ADMIN_PASSWORD=Change_me_locally_1

# Optional notifications for `platform-ops incidents ingest` (Phase 14): a page,
# update or resolution goes to each team's Slack `channel` and Telegram
# `telegram_chat` in config/teams.yaml. Left unset, notifications are recorded in
# the incident store and the log only, which is the supported default. The
# simulated company's own pages always stay local.
# SLACK_BOT_TOKEN=
# TELEGRAM_BOT_TOKEN=

# Phase 14b: hooks that orchestrators call (orchestrators/README.md). The CLI they
# run, and the consuming repository's ownership registry, when not the defaults.
# PLATFORM_OPS_CLI=/opt/toolkit/bin/platform-ops
# PLATFORM_OPS_REGISTRY_DIR=
# The chat double the orchestrator tests page into (docker compose --profile chat).
# CHAT_DOUBLE_PORT=8099

# Airflow with Cosmos (`make airflow`, Phase 14b): the UI's admin password, with
# no default, and its port. The stack runs its own company (namespace af_).
AIRFLOW_ADMIN_PASSWORD=change_me_locally_airflow
# AIRFLOW_PORT=8080

# Dagster with dagster-dbt (`make dagster`, Phase 14b): its port, published on
# this machine only, since Dagster's open source UI has no login. The stack
# runs its own company (namespace dg_).
# DAGSTER_PORT=3001
