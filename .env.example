# Copy to .env and edit. .env is gitignored and must never be committed.
#   cp .env.example .env

# Postgres: the default legacy source, always started by `make up`.
POSTGRES_USER=platform_ops
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=legacy
POSTGRES_PORT=5432

# SQL Server: optional, started only with `docker compose --profile sqlserver up -d`.
# The password must meet the SQL Server complexity policy (8+ chars, mixed case,
# digit, symbol) or the container exits on boot.
MSSQL_SA_PASSWORD=Change_Me_Locally_1
MSSQL_PORT=1433

# Optional Phase 3 Slack notifier. Left unset, incidents are written to
# ops.notifications and the local log only, which is the supported default.
# SLACK_WEBHOOK_URL=
