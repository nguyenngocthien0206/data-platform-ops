# Copy to .env and edit. .env is gitignored and must never be committed.
#   cp .env.example .env

# Postgres: the company's legacy database, and the toolkit's own results in a
# second database (platform_ops). Started by `make up`.
POSTGRES_USER=platform_ops
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=legacy
POSTGRES_PORT=5432

# ClickHouse: the company's warehouse, where dbt builds. Started by `make up`.
CLICKHOUSE_USER=platform_ops
CLICKHOUSE_PASSWORD=change_me_locally
CLICKHOUSE_PORT=8123

# The simulated company's ClickHouse users (version 2.0): one per team, plus
# the BI tool and the two pipelines. Each has its own password, and nothing
# defaults them: a missing one stops `make demo` and names the variable.
CLICKHOUSE_PASSWORD_PLATFORM=change_me_locally_platform
CLICKHOUSE_PASSWORD_SALES=change_me_locally_sales
CLICKHOUSE_PASSWORD_MARKETING=change_me_locally_marketing
CLICKHOUSE_PASSWORD_FINANCE=change_me_locally_finance
CLICKHOUSE_PASSWORD_PRODUCT=change_me_locally_product
CLICKHOUSE_PASSWORD_METABASE=change_me_locally_metabase
CLICKHOUSE_PASSWORD_DBT=change_me_locally_dbt
CLICKHOUSE_PASSWORD_LOADER=change_me_locally_loader

# Metabase, the company's BI (`make metabase`): its port, and the admin account
# `platform-ops metabase provision` creates on first start and logs in with.
METABASE_PORT=3000
MB_ADMIN_EMAIL=admin@company.test
MB_ADMIN_PASSWORD=Change_me_locally_1

# Optional Phase 3 Slack notifier. Left unset, incidents are written to
# ops.notifications and the local log only, which is the supported default.
# SLACK_WEBHOOK_URL=
